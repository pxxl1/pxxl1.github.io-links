  <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #1a1e25;
      --card: #222831;
      --card-hover: #29303a;
      --text: #e7e4dd;
      --accent: #7cc4b9;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--bg); color: var(--text);
      font-family: 'Public Sans', system-ui, sans-serif;
      min-height: 100vh; -webkit-font-smoothing: antialiased;
    }
    main { max-width: 460px; margin: 0 auto; padding: 56px 24px 48px; text-align: center; }
    .avatar {
      width: 128px; height: 128px; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto;
    }
    h1 { font-size: 1.75rem; font-weight: 700; margin: 22px 0 40px; }
    .links { display: grid; gap: 14px; }
    .links a {
      display: flex; align-items: center; gap: 20px;
      background: var(--card); color: var(--text); text-decoration: none;
      border-radius: 10px; padding: 18px 22px; font-size: 1.1rem; text-align: left;
      transition: background .15s;
    }
    .links a:hover { background: var(--card-hover); }
    .links a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .links svg { width: 26px; height: 26px; flex-shrink: 0; fill: var(--accent); }
    .links svg.stroke { fill: none; stroke: var(--accent); stroke-width: 2; }
  </style>
</head>
